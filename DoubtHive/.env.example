# -------------------------------------------------------------
# DoubtHive Server Environment Variables
# Copy this file to server/.env and fill in real values
# -------------------------------------------------------------

# Server Port (Render sets process.env.PORT automatically)
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/doubthive?retryWrites=true&w=majority
# Local: mongodb://127.0.0.1:27017/doubthive
MONGO_URI=mongodb://127.0.0.1:27017/doubthive

# JWT Authentication Secret (Generate a strong 32+ character random string)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# Allowed Frontend URL for CORS (no trailing slash)
# Local: http://localhost:5173
# Production: https://your-doubthive-app.vercel.app
CLIENT_URL=http://localhost:5173

# -------------------------------------------------------------
# Automatic Email Notification System (Nodemailer)
# -------------------------------------------------------------
# In local development, if SMTP credentials are empty, DoubtHive will
# safely log email payloads to the terminal without crashing.
# In production, supply your SMTP credentials:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_or_smtp_key
EMAIL_FROM="DoubtHive Notifications" <no-reply@doubthive.com>

# Administrator Alert Email (receives unassigned doubt alerts & moderation notices)
ADMIN_EMAIL=admin@doubthive.com
