# -------------------------------------------------------------
# DoubtHive Client Environment Variables
# -------------------------------------------------------------

# Backend API base URL (Render deployment or local server)
# In production on Vercel, set this to your deployed Render URL:
# Example: https://doubthive-api.onrender.com/api
# In local development, you can point to http://localhost:5000/api or leave unset to use the Vite dev proxy
VITE_API_URL=http://localhost:5000/api
