{
  "name": "doubthive",
  "version": "1.0.0",
  "description": "DoubtHive - A Gamified Doubt Resolution Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,green \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "start": "npm run start --prefix server",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "seed": "npm run seed --prefix server",
    "test": "npm run test --prefix server",
    "test:email": "npm run test:email --prefix server",
    "test:all": "npm run test:all --prefix server"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
